# Copy to .env and edit. Never commit .env. Every value is optional; defaults are shown.

# ---------- Part A: data pipeline ----------
# TICKETS_DB_PATH=warehouse/tickets.duckdb
# TICKETS_INCOMING_DIR=data/incoming
# TICKETS_REFERENCE_DIR=data/reference
# TICKETS_OUTPUT_DIR=outputs/pipeline

# ---------- Part B: RAG service ----------
# LLM: mock (default, offline, no key) | openai | anthropic
LLM_PROVIDER=mock
# LLM_MODEL=                      # openai default gpt-4.1-mini, anthropic default claude-haiku-5-5
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Embeddings: auto (model if available, else offline LSA) | sentence-transformers | lsa
# EMBEDDING_BACKEND=auto
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Re-ranking: auto | cross-encoder | none
# RERANKER_BACKEND=auto
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval and abstention
# CHUNK_SIZE_WORDS=180
# CHUNK_OVERLAP_WORDS=30
# TOP_K=5
# CANDIDATE_K=20
# MIN_CONFIDENCE=0.35

# Paths
# KB_DIR=data/kb
# INDEX_DIR=warehouse/index

# Guardrails
# MAX_QUESTION_CHARS=1000
# SQL_ROW_LIMIT=100
# SQL_TIMEOUT_S=5
